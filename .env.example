# Copy to .env and replace the development values before exposing FlowBridge.
POSTGRES_USER=flowbridge
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=flowbridge

# Use the same strong random value for API sessions and credential encryption.
FLOWBRIDGE_SECRET_KEY=replace-with-a-strong-random-secret
SESSION_COOKIE_SECURE=false
FLOWBRIDGE_RUN_TIMEOUT_SECONDS=3600

# GitHub OAuth App callback URL must match exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
FRONTEND_URL=http://localhost:5173

# Optional host port changes.
FLOWBRIDGE_FRONTEND_PORT=5173
FLOWBRIDGE_API_PORT=8000
