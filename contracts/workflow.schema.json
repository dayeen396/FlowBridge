{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_handle": {
          "default": "main",
          "title": "Source Handle",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "target_handle": {
          "const": "main",
          "default": "main",
          "title": "Target Handle",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "on_error": {
          "default": "stop",
          "enum": [
            "stop",
            "continue"
          ],
          "title": "On Error",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        }
      },
      "required": [
        "id",
        "type",
        "name"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeType": {
      "enum": [
        "manual_trigger",
        "webhook",
        "http_request",
        "data_processing",
        "condition",
        "send_email",
        "mcp_tool"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "Position",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "backoff_multiplier": {
          "default": 2.0,
          "maximum": 10,
          "minimum": 1,
          "title": "Backoff Multiplier",
          "type": "number"
        },
        "backoff_seconds": {
          "default": 2.0,
          "maximum": 300,
          "minimum": 0,
          "title": "Backoff Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "default": "",
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "maxItems": 300,
      "title": "Edges",
      "type": "array"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "nodes"
  ],
  "title": "Workflow",
  "type": "object"
}
